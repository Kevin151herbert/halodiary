# Supabase (Project Settings > API). Either key name works.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: scheduler cron, PayPal webhooks and agent tokens. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# AI assistant (Anthropic). Without a key the assistant panel explains how to enable it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional: signs tool approval requests in the assistant chat
TOOL_APPROVAL_SECRET=

# PayPal sandbox (developer.paypal.com > Apps & Credentials > Sandbox).
# Leave empty to run payments in clearly labelled "simulated" mode.
PAYPAL_ENV=sandbox
NEXT_PUBLIC_PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# ID of the webhook pointing at /api/paypal/webhook
PAYPAL_WEBHOOK_ID=
# Sandbox personal account that receives provider payouts for demo providers
PAYPAL_PAYOUT_RECEIVER=

# Shared with the Render cron job (render.yaml) that calls /api/cron/advance
CRON_SECRET=

# Public URL of the deployed app (used for PayPal return links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
